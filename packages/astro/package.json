{
  "name": "@malihub/git-headless-cms-astro",
  "version": "0.1.0",
  "description": "Astro Integration for git-headless-cms (Auto API route injection and components)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/endpoints/*": "./dist/endpoints/*",
    "./endpoints/*": {
      "types": "./dist/endpoints/*.d.ts",
      "import": "./dist/endpoints/*.js"
    },
    "./endpoints/*.js": {
      "types": "./dist/endpoints/*.d.ts",
      "import": "./dist/endpoints/*.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/endpoints/*.ts --out-dir dist --format esm --dts --clean",
    "dev": "tsup src/index.ts src/endpoints/*.ts --out-dir dist --format esm --dts --watch"
  },
  "dependencies": {
    "@malihub/git-headless-cms-core": "^0.1.0"
  },
  "peerDependencies": {
    "astro": ">=4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "astro": "^4.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "git-cms",
    "git-headless-cms"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malihub-digital/git-headless-cms.git",
    "directory": "packages/astro"
  },
  "author": "MaliHub",
  "license": "MIT"
}
