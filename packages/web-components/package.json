{
  "name": "@malihub/git-headless-cms-web-components",
  "version": "0.1.3",
  "description": "Framework-agnostic Web Components UI toolbar and inline editor for git-headless-cms",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "git-cms",
    "git-headless-cms",
    "inline-editing"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malihub-digital/git-headless-cms.git",
    "directory": "packages/web-components"
  },
  "author": "MaliHub",
  "license": "MIT"
}